{
  "expo": {
    "name": "BenchLedger",
    "slug": "benchledger",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "scheme": "benchledger",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#f5f4f1",
    "ios": {
      "bundleIdentifier": "app.benchledger.mobile",
      "buildNumber": "2",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Connect to the BenchLedger server you choose on your local network.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true,
          "NSExceptionDomains": {
            "lan": {
              "NSIncludesSubdomains": true,
              "NSExceptionAllowsInsecureHTTPLoads": true
            },
            "home.arpa": {
              "NSIncludesSubdomains": true,
              "NSExceptionAllowsInsecureHTTPLoads": true
            }
          }
        },
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.benchledger.mobile",
      "permissions": [
        "android.permission.INTERNET"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#aa3e0d"
      },
      "userInterfaceStyle": "automatic"
    },
    "plugins": [
      "expo-secure-store",
      "./plugins/with-local-network.cjs",
      "expo-status-bar"
    ]
  }
}
