      "html": "<label class=\"ds-field\"><span class=\"ds-field-label\">Part name</span><input class=\"ds-input\" value=\"Bracket\"/><small class=\"ds-field-hint\">Use a name you can recognise.</small></label>",
      "css": ".ds-field{font-family:var(--font-ui,\"IBM Plex Sans Variable\",system-ui,sans-serif);display:grid;gap:7px;color:var(--foreground,#152033)}.ds-field-label{font-size:.9375rem;font-weight:500}.ds-input{font-family:var(--font-ui,\"IBM Plex Sans Variable\",system-ui,sans-serif);width:100%;min-height:44px;padding:10px 12px;border:1px solid var(--input,#bcc7d5);border-radius:7px;background:var(--card,#fff);color:var(--foreground,#152033);font-size:1rem;line-height:1.45;caret-color:var(--primary,#1558e8)}.ds-input:focus-visible{outline:2px solid var(--ring,#1558e8);outline-offset:3px;}.ds-input:disabled{opacity:.5;cursor:not-allowed}.ds-field-hint{font-size:.875rem;line-height:1.5;color:var(--muted-foreground,#536276)}"
