      "css": ".ds-secondary{font-family:var(--font-ui,\"IBM Plex Sans Variable\",system-ui,sans-serif);font-size:.9375rem;font-weight:500;line-height:1.4;min-height:42px;padding:10px 16px;border-radius:7px;cursor:pointer;background:var(--card,#fff);color:var(--foreground,#152033);border:1px solid var(--input,#bcc7d5)}.ds-secondary:hover:not(:disabled){background:var(--muted,#f1f3f6)}.ds-secondary:focus-visible{outline:2px solid var(--ring,#1558e8);outline-offset:3px;}.ds-secondary:disabled{opacity:.5;cursor:not-allowed}@media(max-width:800px){.ds-secondary{min-height:44px}}@media(prefers-reduced-motion:no-preference){.ds-secondary{transition:background-color 160ms ease-out,color 160ms ease-out}}"
