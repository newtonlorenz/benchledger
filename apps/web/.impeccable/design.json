      "css": ".ds-surface{font-family:var(--font-ui,\"IBM Plex Sans Variable\",system-ui,sans-serif);padding:24px;border:1px solid var(--border,#dce1e8);border-radius:8px;background:var(--card,#fff);color:var(--foreground,#152033);box-shadow:none}.ds-surface-title{margin:0;font-size:1.25rem;font-weight:600;line-height:1.3}.ds-surface-copy{margin:12px 0 0;font-size:.9375rem;line-height:1.55;color:var(--ink-soft,#42516a)}"
