  "components": [
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Primary action within the current task.",
      "html": "<button class=\"ds-primary\">Save changes</button>",
      "css": ".ds-primary{font-family:var(--font-ui,\"IBM Plex Sans Variable\",system-ui,sans-serif);font-size:.9375rem;font-weight:500;line-height:1.4;min-height:42px;padding:10px 16px;border-radius:7px;cursor:pointer;background:var(--primary,#1558e8);color:var(--primary-foreground,#fff);border:1px solid transparent}.ds-primary:hover:not(:disabled){background:var(--accent-hover,#1044b8)}.ds-primary:focus-visible{outline:2px solid var(--ring,#1558e8);outline-offset:3px;}.ds-primary:disabled{opacity:.5;cursor:not-allowed}@media(max-width:800px){.ds-primary{min-height:44px}}@media(prefers-reduced-motion:no-preference){.ds-primary{transition:background-color 160ms ease-out,color 160ms ease-out}}"
    },
    {
