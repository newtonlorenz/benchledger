      "css": ".ds-text{font-family:var(--font-ui,\"IBM Plex Sans Variable\",system-ui,sans-serif);display:inline-flex;align-items:center;min-height:40px;padding:4px 0;border:0;background:transparent;color:var(--primary,#1558e8);font-size:.9375rem;font-weight:500;line-height:1.4;cursor:pointer}.ds-text:hover:not(:disabled){text-decoration:underline;text-underline-offset:3px}.ds-text:focus-visible{outline:2px solid var(--ring,#1558e8);outline-offset:3px;}.ds-text:disabled{opacity:.5;cursor:not-allowed}@media(max-width:800px){.ds-text{min-height:44px}}"
