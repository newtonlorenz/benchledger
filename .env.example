# Copy outside the public checkout and replace every value.
# Compose interpolation only: set this to the private absolute env file used
# by deploy/compose.example.yml. If omitted, Compose uses ../.env relative to
# that Compose file for local use; never put production secrets in the checkout.
# BENCHLEDGER_ENV_FILE=/absolute/private/path/benchledger.env
BENCHLEDGER_HOST=0.0.0.0
BENCHLEDGER_PORT=8792
# Exact external origin used for MCP artifact transfer capabilities; never derive this from Host.
# Its host is also the Host allow-list (with loopback names) that blocks DNS rebinding.
BENCHLEDGER_PUBLIC_BASE_URL=http://127.0.0.1:8792
# Optional extra Host names or IP addresses (no scheme/port) users reach the server by.
# Behind a reverse proxy, forward the original Host (nginx: proxy_set_header Host $host;)
# or list the upstream/service name the proxy or a health probe uses here.
# BENCHLEDGER_ALLOWED_HOSTS=benchledger.local,192.0.2.10
BENCHLEDGER_DATA_DIR=/var/lib/benchledger
BENCHLEDGER_MAX_STORAGE_BYTES=10737418240
# Governs artifact upload request bodies; other routes stay capped at 2 MiB.
BENCHLEDGER_MAX_UPLOAD_BYTES=104857600
# Generate with `openssl rand -base64 48`; startup rejects this placeholder.
BENCHLEDGER_SESSION_SECRET=replace-with-at-least-32-random-bytes
# Optional one-time browser password bootstrap. Leave unset for LAN-open mode;
# after first startup, the durable Settings value is authoritative.
# BENCHLEDGER_ADMIN_PASSWORD_HASH=replace-with-a-scrypt-hash-from-hashAdminPassword
# Bearer configuration accepts digests only; keep plaintext tokens in the agent's secret store.
# BENCHLEDGER_MCP_READ_TOKEN_HASHES=64-lowercase-hex-digest[,another-digest]
# A write token also receives read access; least privilege does not grant admin.
# BENCHLEDGER_MCP_WRITE_TOKEN_HASHES=64-lowercase-hex-digest[,another-digest]
# BENCHLEDGER_MCP_ADMIN_TOKEN_HASHES=64-lowercase-hex-digest
# Unset: Secure cookies follow the public base URL scheme (https => true).
# With an https public base URL, plain-HTTP access via an ALLOWED_HOSTS address cannot
# keep a session unless this is false. Set false only for plain-HTTP LAN access;
# browsers then send session cookies unencrypted.
# BENCHLEDGER_SECURE_COOKIES=true
# false, a proxy hop count such as 1 (`true` means 1), or comma-separated proxy IPv4/IPv6
# addresses/CIDRs; invalid entries stop startup.
BENCHLEDGER_TRUST_PROXY=false
# The example Compose file defaults to loopback; set this to one exact LAN address when needed.
BENCHLEDGER_BIND_ADDRESS=127.0.0.1
