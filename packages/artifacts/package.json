{
  "name": "@benchledger/artifacts",
  "version": "0.1.0",
  "description": "Content-addressed project artifact storage for BenchLedger",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
